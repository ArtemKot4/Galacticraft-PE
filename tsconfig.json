{
	"compilerOptions": {
		"outDir": ".",
		"target": "es5",
		"lib": [
			"es5",
			"es2015.core",
			"es2015.generator"
		],
		"module": "none",
		"skipDefaultLibCheck": true,
		"composite": true,
		"downlevelIteration": false,
		"experimentalDecorators": true,
		"noEmitOnError": true,
		"stripInternal": true,
		"allowJs": true,
		"jsx": "react",
		"jsxFactory": "UI.JSX.parse",
		"jsxFragmentFactory": "UI.JSX.Fragment",
		"strict": false,
		"strictNullChecks": false,
		"ignoreDeprecations": "6.0",
		"noImplicitOverride": true
	},
	"compileOnSave": false,
	"exclude": [
		"dom",
		"dom.iterable",
		"es2015.iterable",
		"scripthost",
		"webworker",
		"webworker.importscripts",
		"webworker.iterable"
	],
	"include": [],
	"files": [
		"declarations/StorageInterface.d.ts",
		"declarations/ToolLib.d.ts",
		"declarations/DependenceHelper.d.ts",
		"declarations/ChargeItem.d.ts",
		"declarations/energy-net.d.ts",
		"declarations/ConnectedTexture.d.ts",
		"declarations/RecipeViewer.d.ts",
		"declarations/ChargeItemRegistry.d.ts",
		"declarations/main.d.ts",
		"declarations/RedstoneSignalParams.d.ts",
		"declarations/DungeonUtility.d.ts",
		"declarations/GalacticraftExtras.d.ts"
	]
}
